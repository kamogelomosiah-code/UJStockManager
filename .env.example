# Copy to .env for local development. Never commit .env.

# --- Sign-in (required in production) ---
# The two passcodes people type to get in. They are checked on the server and are never in the page.
# In development, if neither is set, the demo passcodes owner123 / admin123 work. In production nobody can sign in until these are set.
OWNER_PASSCODE=
ADMIN_PASSCODE=
# Signs the sign-in sessions. Set a long random value so people stay signed in across restarts.
SESSION_SECRET=

# --- MasterAPI: the shared backend (optional) ---
# Saves the stock so every phone and computer sees the same stock, and powers the AI.
# Create an app in the MasterAPI console and copy the two lines it shows you.
MASTERAPI_URL=
MASTERAPI_KEY=

# --- Gemini (optional, used only if MasterAPI's AI cannot answer) ---
GEMINI_API_KEY=
